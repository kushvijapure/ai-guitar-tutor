{
  "name": "ai-guitar-tutor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/fetch-assets.mjs",
    "prebuild": "node scripts/fetch-assets.mjs",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "verify": "esbuild scripts/verify-dsp.ts --bundle --platform=node --format=esm --outfile=scripts/verify-dsp.mjs && node scripts/verify-dsp.mjs",
    "measure": "esbuild scripts/measure-gates.ts --bundle --platform=node --format=esm --outfile=scripts/measure-gates.mjs && node scripts/measure-gates.mjs",
    "bench": "esbuild scripts/bench.ts --bundle --platform=node --format=esm --outfile=scripts/bench.mjs && node scripts/bench.mjs",
    "ci": "npm run typecheck && npm run lint && npm test && npm run verify && npm run build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.7"
  }
}
